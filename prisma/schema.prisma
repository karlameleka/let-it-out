generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Set when a password-reset email is requested; cleared once used or
  // once a new one is issued. The token itself is never stored — only a
  // hash of it — so a database leak can't be used to reset accounts.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  // Optional demographics, collected (never required) at signup or added
  // later from account settings. Age is stored as a bucketed range rather
  // than a birth date, both to avoid needing upkeep and to keep what we
  // hold on each person to the minimum useful for understanding our users.
  ageRange       String?
  gender         String?
  country        String?
  referralSource String?

  journalEntries JournalEntry[]
  bookingRequests BookingRequest[]
  orders         Order[]
  pushSubscriptions PushSubscription[]
}

model Counselor {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  credentials  String
  bio          String   @db.Text
  specialties  String[]
  photoUrl     String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  // Full Cal.com booking link (e.g. "https://cal.com/karla-meleka/50min").
  // When set, the counselor's page embeds live Cal.com scheduling instead
  // of the manual request form.
  bookingUrl   String?

  bookingRequests BookingRequest[]
}

enum SessionType {
  INDIVIDUAL_COUNSELING
  COUPLES_COUNSELING
  FOLLOW_UP
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model BookingRequest {
  id             String        @id @default(cuid())
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  counselor      Counselor     @relation(fields: [counselorId], references: [id])
  counselorId    String
  name           String
  email          String
  phone          String
  sessionType    SessionType   @default(INDIVIDUAL_COUNSELING)
  preferredDate  String
  preferredTime  String
  message        String?       @db.Text
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

enum InquiryStatus {
  NEW
  IN_DISCUSSION
  SCHEDULED
  CLOSED
}

model WorkshopInquiry {
  id               String        @id @default(cuid())
  organizationName String
  contactName      String
  email            String
  phone            String
  workshopTopic    String
  groupSize        String?
  preferredDates   String?
  message          String?       @db.Text
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
}

enum ProductCategory {
  JOURNAL
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String          @db.Text
  category    ProductCategory @default(JOURNAL)
  coverImageUrl String?
  durationDays  Int?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)

  variants   ProductVariant[]
  orderItems OrderItem[]
}

enum ProductFormat {
  PHYSICAL
  EBOOK
}

model ProductVariant {
  id         String        @id @default(cuid())
  product    Product       @relation(fields: [productId], references: [id])
  productId  String
  format     ProductFormat
  priceEGP   Int
  sku        String        @unique

  orderItems OrderItem[]

  @@unique([productId, format])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  INSTAPAY
  CASH_ON_DELIVERY
  PAYMOB
}

model Order {
  id              String        @id @default(cuid())
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  guestName       String
  guestEmail      String
  guestPhone      String
  shippingAddress String?       @db.Text
  googleMapsLink  String?
  country         String?
  governorate     String?
  needsShipping   Boolean       @default(false)
  subtotalEGP     Int
  shippingFeeEGP  Int           @default(0)
  totalEGP        Int
  paymentMethod   PaymentMethod @default(INSTAPAY)
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentRef      String?
  paymentNote     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]
}

model OrderItem {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          String
  product          Product        @relation(fields: [productId], references: [id])
  productId        String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  quantity         Int
  unitPriceEGP     Int
  titleSnapshot    String
  formatSnapshot   ProductFormat
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model WorkshopInterestSignup {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())
}

model JournalPrompt {
  id        String   @id @default(cuid())
  dayNumber Int      @unique
  category  String
  text      String   @db.Text

  entries JournalEntry[]
}

model JournalEntry {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id])
  userId    String
  prompt    JournalPrompt? @relation(fields: [promptId], references: [id])
  promptId  String?
  content   String         @db.Text
  mood      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum LeadType {
  WORKSHOP_LEAD
  COUNSELING_INQUIRY
  JOURNAL_CUSTOMER
  GENERAL_INQUIRY
  ACCOUNT_SIGNUP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/** Unified CRM record — one row per real workshop lead, counseling inquiry,
 * journal order, or general inquiry, created alongside each source record
 * so the whole pipeline can be tracked and worked from one place. */
model Lead {
  id            String     @id @default(cuid())
  name          String
  type          LeadType
  status        LeadStatus @default(NEW)
  email         String?
  phone         String?
  source        String?
  sessionType   String?
  groupSize     Int?
  orderTotalEGP Int?
  paymentMethod String?
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
