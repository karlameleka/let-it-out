generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Collected on the signup wizard's country page (calling code + number,
  // stored together as one E.164-ish string, e.g. "+201001234567") — used
  // to prefill checkout/booking forms with the number they already gave
  // us. Nullable only for accounts created before this was required
  // again. Never a login identifier.
  phone        String?  @unique
  // Nullable: accounts created via Google sign-in have no password.
  passwordHash String?
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  // Set for accounts created or linked via "Sign in with Google" — the
  // stable Google account id ("sub" claim), used to find the account on
  // repeat sign-ins without depending on email.
  googleId String? @unique

  // Same idea as googleId, for "Sign in with Apple" — Apple's stable
  // per-user, per-Services-ID identifier (the id_token's "sub" claim).
  appleId String? @unique

  // Short human-readable identifier shown on the admin client list (e.g.
  // over phone/email support) — never the raw internal id. Assigned by a
  // DB sequence via generate_account_code(); see the account_code
  // migration.
  accountCode String @unique @default(dbgenerated("generate_account_code()"))

  // Personal invite-a-friend code, shown as a link/QR code in Account
  // settings. Random (not sequential like accountCode) since it's shared
  // publicly and guessability would let someone mint referral rewards
  // against a stranger's account. Assigned by generate_referral_code();
  // see the referral_system migration.
  referralCode String @unique @default(dbgenerated("generate_referral_code()"))

  // Set when a password-reset email is requested; cleared once used or
  // once a new one is issued. The token itself is never stored — only a
  // hash of it — so a database leak can't be used to reset accounts.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  // Throttles forgot-password requests per account so the form can't be
  // used to email-bomb someone's inbox.
  lastPasswordResetRequestAt DateTime?

  // Brute-force login lockout: counts consecutive failed password checks,
  // reset to 0 on a successful login. lockedUntil is set once the count
  // crosses the threshold and cleared automatically once it elapses.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Optional TOTP two-factor authentication, currently offered to ADMIN
  // accounts only (the highest-privilege role). totpSecret is stored
  // AES-256-GCM encrypted at rest (see src/lib/totp.ts), never in plaintext.
  totpSecret            String?
  totpEnabled           Boolean  @default(false)
  totpBackupCodeHashes  String[] @default([])

  // Demographics, required at signup (collected once, not editable later
  // from account settings). Columns stay nullable so accounts created
  // before this requirement existed don't break.
  birthDate      DateTime? @db.Date
  gender         String?
  country        String?
  referralSource String?
  // Which of our services the person is interested in — multi-select at
  // signup (e.g. ["Journaling", "Counseling"]).
  serviceInterests String[] @default([])

  // Three separate consents required on the signup wizard's final "agree"
  // step (Data Processing, Telehealth, and Terms of Care) — timestamped
  // rather than a single boolean so there's a compliance record of when
  // each specific consent was given, not just that some consent was.
  // Nullable for accounts created before this was required.
  consentDataProcessingAt DateTime?
  consentTelehealthAt     DateTime?
  consentTermsOfCareAt    DateTime?

  // Off by default, matching Apple Journal — opt-in from account settings.
  journalLockEnabled Boolean @default(false)

  // First-time onboarding (welcome modal + setup checklist), see
  // src/lib/onboarding.ts. Nullable "seen/done" timestamps rather than
  // booleans so a debug/support query can tell not just whether but when.
  // Backfilled to non-null for every pre-existing account in this
  // feature's migration so only genuinely new signups see the welcome
  // modal — the two step-completion columns are deliberately left null
  // for existing accounts, since showing an honestly-partial checklist to
  // a returning user is fine, unlike re-showing the welcome modal.
  onboardingWelcomeSeenAt        DateTime?
  onboardingChecklistDismissedAt DateTime?
  onboardingJournalDoneAt        DateTime?
  onboardingCounselingDoneAt     DateTime?

  // Site language preference, captured at signup and kept in sync on every
  // setLocale() call (see src/lib/i18n/actions.ts) — the same pattern as
  // PushSubscription.locale. Needed so staff-triggered emails (a counselor
  // assigning a resource or posting a meeting link) can be sent in the
  // client's own language even though the action runs from the counselor's
  // browser, which has no access to the client's locale cookie.
  locale String @default("en")

  journalEntries JournalEntry[]
  bookingRequests BookingRequest[]
  orders         Order[]
  pushSubscriptions PushSubscription[]
  webauthnCredentials WebAuthnCredential[]
  supportChats   SupportChat[]
  eventRsvps     EventRSVP[]
  reflectionPrompts ReflectionPrompt[]
  notificationReads NotificationRead[]
  pageViews       PageView[]
  referralsGiven  UserReferral[]
  auditLogs       AuditLog[]
  trashedItems    TrashedItem[]
  feedback        Feedback[]
  analyticsEvents AnalyticsEvent[]
}

// A signup that hasn't finished OTP verification yet. Holds everything
// needed to create the real User once the code is confirmed, so nothing is
// written to the User table (and no email is "claimed") until the person
// actually proves they own the address. Replaced (not updated) on every
// new attempt for the same email — see requestSignupOtp in auth-actions.ts.
// Only holds what's known once the signup wizard's email page is verified
// (name/email/birthday/gender) — password, country, referral source, and
// interests are collected on later pages and go straight from that final
// form submission into the real User row in completeSignup, never through
// here. See requestEmailVerification / verifyEmailVerification / completeSignup
// in auth-actions.ts.
model PendingSignup {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  birthDate       DateTime  @db.Date
  gender          String
  emailVerifiedAt DateTime?

  otpCodeHash   String
  otpExpiresAt  DateTime
  otpSentAt     DateTime @default(now())
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
}

model Counselor {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  credentials  String
  bio          String   @db.Text
  specialties  String[]
  languages    String[] @default([])
  // Optional Arabic translations, nullable/empty and falling back to the
  // English fields whenever unset — same pattern as Article/Product above.
  // specialtiesAr/languagesAr are matched to specialties/languages by index.
  nameAr        String?
  credentialsAr String?
  bioAr         String?  @db.Text
  specialtiesAr String[] @default([])
  languagesAr   String[] @default([])
  photoUrl     String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  // Notified alongside the admin inbox on every counseling inquiry/booking
  // for this counselor. Null skips the counselor notification silently.
  email        String?
  // Session price in EGP. When set, the counselor's page requires payment
  // upfront, then lets the client pick an exact date/time from this
  // counselor's own CounselorAvailability windows. When null, visitors use
  // the free manual request form instead (BookingRequest, human-confirmed).
  priceEGP     Int?
  // Controls whether the booking UI on this counselor's page is live.
  // WAITLIST/UNAVAILABLE both show a badge and hide the booking form.
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  // Admin-granted permission letting this counselor edit the *shared,
  // sitewide* intake form and reflection sheet question sets from their
  // own /therapist portal (see requireFormsConfigEditor in
  // forms-config-auth.ts) — the same singleton config the admin dashboard
  // edits, not a per-counselor copy. Off by default; most counselors never
  // see those tabs.
  canEditFormsConfig Boolean @default(false)

  // Admin-granted permission letting this counselor add/discontinue
  // medications for their clients from their own /therapist portal (see
  // Medication below) — reserved for psychiatrists, since prescribing is
  // outside most counselors' clinical scope. Off by default.
  canPrescribeMedication Boolean @default(false)

  // Self-service therapist portal login (/therapist). Null passwordHash
  // means portal access hasn't been set up yet for this counselor — an
  // admin sends a setup link from /admin/counselors/[id], which uses the
  // same reset-token flow as an ordinary password reset. Same
  // brute-force-lockout shape as User (see auth-actions.ts) — kept as
  // separate columns rather than merging into the User table since a
  // counselor isn't a client account and has no signup flow of its own.
  passwordHash               String?
  resetTokenHash             String?   @unique
  resetTokenExpiresAt        DateTime?
  lastPasswordResetRequestAt DateTime?
  failedLoginAttempts        Int       @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?

  // A one-click, single-use, passwordless login link an admin can send from
  // /admin/counselors/[id] — an alternative to sendTherapistPortalSetupLink
  // for when the point is just getting the therapist back into their own
  // account, not making them set a new password every time. Short TTL
  // since it's a direct login bypass, not just a "set password" step.
  loginTokenHash      String?   @unique
  loginTokenExpiresAt DateTime?

  // Keys from CLIENT_TOOLS (therapist-toolkit.ts) this counselor has hidden
  // from their own Toolkit page — the built-in tools stay real app
  // features, just personally toggled off rather than deleted.
  hiddenDefaultTools String[] @default([])
  // Per-counselor override of the "Session prompts" cards shown on their own
  // Toolkit page (PromptCard[] shape, see therapist-toolkit.ts). Null means
  // this counselor hasn't customized it yet, so the built-in SESSION_PROMPTS
  // constant is shown instead — same null-means-defaults pattern as
  // specialtiesAr/languagesAr elsewhere on this model.
  sessionPromptCards Json?

  bookingRequests     BookingRequest[]
  sessionBookings     SessionBooking[]
  promoCodes          PromoCodeCounselor[]
  intakeSubmissions   IntakeSubmission[]
  clientNotes         ClientNote[]
  medications         Medication[]
  toolkitItems        ToolkitItem[]
  referralsSent       Referral[]              @relation("ReferralsSent")
  referralsReceived   Referral[]              @relation("ReferralsReceived")
  assignedResources   AssignedResource[]
  availabilityWindows CounselorAvailability[]
  filters             CounselorFilterAssignment[]
  manualClients       ManualClient[]
}

// A client a therapist (or an admin, on their behalf) added by hand rather
// than one who arrived through a booking — e.g. someone referred in
// person, over the phone, or from another practice, who hasn't booked a
// session yet. Keyed the same no-FK way every other client record is
// (clientEmail as a plain string, see ClientNote/Medication/AssignedResource)
// since there's often no User account behind them. deriveClients() merges
// this in alongside booking-derived clients; if the same email later books
// a session, the two just describe the same person, referralSource carries
// over.
model ManualClient {
  id             String    @id @default(cuid())
  counselor      Counselor @relation(fields: [counselorId], references: [id])
  counselorId    String
  name           String
  clientEmail    String
  phone          String?
  // Free text — "how did this client hear about us" — not the same concept
  // as the Referral model (a counselor-to-counselor case handoff) or
  // UserReferral (the invite-a-friend promo code system).
  referralSource String?   @db.Text
  addedBy        String    // "THERAPIST" | "ADMIN"
  createdAt      DateTime  @default(now())

  @@unique([counselorId, clientEmail])
  @@index([counselorId])
}

// Admin-defined filter chips shown on /counseling (e.g. "Prescribes
// medication") — replaces what used to be a single hardcoded boolean on
// Counselor, so the admin dashboard (/admin/counseling-filters) can add or
// remove filters freely instead of needing a code change per filter.
// Filter chips combine with AND semantics on the public page: a counselor
// must carry every currently-selected filter to match.
model CounselorFilter {
  id        String   @id @default(cuid())
  label     String
  labelAr   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  counselors CounselorFilterAssignment[]
}

model CounselorFilterAssignment {
  id          String          @id @default(cuid())
  counselor   Counselor       @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  counselorId String
  filter      CounselorFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  filterId    String

  @@unique([counselorId, filterId])
}

enum AvailabilityStatus {
  AVAILABLE
  WAITLIST
  UNAVAILABLE
}

enum SessionBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

// A paid pre-booking step for counselors with priceEGP set. When the
// counselor has weekly availability windows configured (see
// CounselorAvailability), the visitor picks a real 50-minute slot in-app
// and pays — preferredTime is set. Counselors without windows configured
// yet fall back to picking just a preferred day and paying; preferredTime
// stays null for those rows and the counselor follows up to confirm a time.
model SessionBooking {
  id            String               @id @default(cuid())
  counselor     Counselor            @relation(fields: [counselorId], references: [id])
  counselorId   String
  name          String
  email         String
  phone         String
  preferredDate String
  // "HH:mm", 24-hour, set only when picked from the in-app slot picker —
  // null means the counselor didn't have availability windows configured
  // yet, so only a preferred day was captured and the exact time is
  // confirmed with the client afterward.
  preferredTime String?
  // Full session price before any discount — the amount actually charged
  // is priceEGP - discountEGP.
  priceEGP      Int
  promoCode     PromoCode?           @relation(fields: [promoCodeId], references: [id])
  promoCodeId   String?
  discountEGP   Int                  @default(0)
  status        SessionBookingStatus @default(PENDING_PAYMENT)
  paymentRef    String?
  paymentNote   String?              @db.Text
  // Set by the counselor from their portal once a session is confirmed —
  // immediately surfaced to the client on /upcoming and emailed to them.
  meetingLink   String?
  // Set the first time the client taps this booking's meeting link from
  // /upcoming — lets it move to /upcoming/past right away instead of
  // waiting for preferredDate to roll into the past.
  joinedAt      DateTime?
  // Set once the day-before push reminder (see the session-reminders cron)
  // has gone out for this booking, so it's never sent twice.
  reminderSentAt DateTime?
  // Set when status flips to CANCELLED (by either the client from
  // /upcoming or the counselor from their portal) — see cancelWindowEnd
  // usage in the trash-purge cron, which hard-deletes a cancelled booking
  // a month after this timestamp. Null for anything never cancelled.
  cancelledAt   DateTime?
  // Site language active when this booking was made — the Paymob webhook
  // that confirms payment runs server-to-server with no visitor cookie, so
  // it needs this to send the confirmation email in the right language.
  locale        String               @default("en")
  // Hashed bearer token required to view/act on this booking's
  // confirmation page as a guest — the id alone is a cuid(), not a
  // cryptographically random secret, so it isn't a safe substitute for an
  // ownership check (see order-access.ts). Null only for bookings created
  // before this field existed, which fall back to the old id-only
  // behavior; every booking created from here on always gets one. Logged-in
  // clients bypass this entirely via an email match instead.
  accessTokenHash String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Tracks an emailed intake-form link without ever storing the answers
// themselves — only enough metadata to validate the link and route the
// eventual submission. The token itself is only ever known as a raw value
// in the emailed URL; here it's stored hashed, same pattern as password
// reset. Counselor name/email are snapshotted at creation so a later
// counselor-record change can't affect where an in-flight link is delivered.
model IntakeFormToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  clientName     String
  clientEmail    String
  counselorId    String
  counselorName  String
  counselorEmail String?
  // Site language active when the session was requested — snapshotted so
  // the intake page renders in the right language regardless of whether
  // the device that later opens the emailed link carries the same locale
  // cookie (e.g. the client opens it on a different browser or phone).
  locale         String    @default("en")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
}

// The actual submitted intake form, persisted so it shows up in that
// client's profile inside the assigned counselor's therapist portal — only
// that counselor can see it (never the admin, never another counselor).
// One row per submission; a client could in principle submit more than
// once across separate booking requests, so this isn't unique per
// counselor+email — the portal always shows the most recent.
model IntakeSubmission {
  id          String    @id @default(cuid())
  counselor   Counselor @relation(fields: [counselorId], references: [id])
  counselorId String
  clientName  String
  clientEmail String
  // [{ section, label, value }] — same shape buildIntakeAnswers() produces.
  answers     Json
  // Best-effort AI-generated clinical-prep summary (see ai-insights.ts) —
  // null when ANTHROPIC_API_KEY isn't configured or the call failed.
  aiSummary   String?   @db.Text
  submittedAt DateTime  @default(now())

  @@index([counselorId, clientEmail])
}

// A therapist's private note logged against one of their clients, tied to
// a specific session date — one page in that client's session "book".
// nextSteps is the plan going into the following session — the portal
// surfaces the most recent note's nextSteps as the client's "current"
// plan, while older notes stay as a running history. moods is the same
// mood-id vocabulary as JournalEntry/the journal app's mood picker (see
// src/lib/moods.ts), letting the therapist log how the client said they
// were feeling that session.
model ClientNote {
  id          String    @id @default(cuid())
  counselor   Counselor @relation(fields: [counselorId], references: [id])
  counselorId String
  clientEmail String
  clientName  String
  sessionDate DateTime  @default(now()) @db.Date
  moods       String[]  @default([])
  notes       String    @db.Text
  nextSteps   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([counselorId, clientEmail])
}

// A medication a psychiatrist has prescribed for a client, added from their
// own /therapist portal (gated by Counselor.canPrescribeMedication — see
// addMedication in therapist-actions.ts, which re-checks that flag server
// side rather than trusting the UI). Visible to the client themselves on
// their My Profile page (matched by email, the same client-identification
// pattern ClientNote uses), and to every counselor treating them, not just
// the one who added it, since a client may see more than one therapist.
model Medication {
  id           String    @id @default(cuid())
  counselor    Counselor @relation(fields: [counselorId], references: [id])
  counselorId  String
  clientEmail  String
  clientName   String
  name         String
  dosage       String?
  instructions String?   @db.Text
  // Discontinued rather than deleted, so the client's history isn't
  // silently erased if a psychiatrist takes them off something.
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([counselorId, clientEmail])
  @@index([clientEmail])
}

enum ToolkitItemKind {
  LINK
  PDF
}

// A resource a therapist has personally added to their own toolbox —
// either an external link or an uploaded PDF (stored as a data URI, same
// pattern as counselor/journal photo uploads — no blob storage wired up).
// The built-in client-facing tools (breathing, reframing, etc. — see
// therapist-toolkit.ts) aren't rows here; a therapist can hide those via
// Counselor.hiddenDefaultTools instead of deleting app data.
model ToolkitItem {
  id          String          @id @default(cuid())
  counselor   Counselor       @relation(fields: [counselorId], references: [id])
  counselorId String
  title       String
  description String?         @db.Text
  kind        ToolkitItemKind
  // Set for LINK items, null for PDF.
  url         String?         @db.Text
  // Set for PDF items (a data: URI), null for LINK.
  fileData    String?         @db.Text
  fileName    String?
  createdAt   DateTime        @default(now())

  @@index([counselorId])
}

enum ReferralType {
  // Handing the client off — the sending therapist steps back, the
  // receiving therapist is expected to take over going forward. Purely a
  // labeled intent: this does not reassign any booking/session data, so
  // the sending therapist's own records and future notification routing
  // are untouched — see the comment on Referral below.
  FULL_REFERRAL
  // Looping another therapist in on a shared case — the client stays with
  // the sending therapist.
  COLLABORATE
}

enum ReferralStatus {
  PENDING
  ACKNOWLEDGED
}

// An internal handoff/collaboration from one therapist to another, with an
// explicit, point-in-time snapshot of whatever the sender chose to share —
// never a live link into the sender's own IntakeSubmission/ClientNote rows.
// This keeps sharing an auditable, one-time act of consent (matching the
// "your answers are shared only with your counselor" promise made to
// clients) rather than opening ongoing cross-counselor access to another
// therapist's private client records.
model Referral {
  id              String         @id @default(cuid())
  fromCounselor   Counselor      @relation("ReferralsSent", fields: [fromCounselorId], references: [id])
  fromCounselorId String
  toCounselor     Counselor      @relation("ReferralsReceived", fields: [toCounselorId], references: [id])
  toCounselorId   String
  clientName      String
  clientEmail     String
  clientPhone     String?
  reason          String         @db.Text
  type            ReferralType
  status          ReferralStatus @default(PENDING)
  // Copy of the latest IntakeSubmission (answers + aiSummary + submittedAt)
  // at the moment of referral, or null if the sender didn't include it.
  intakeSnapshot  Json?
  // Copy of the specific ClientNote rows the sender chose to include:
  // [{ sessionDate, moods, notes, nextSteps }]. Empty/absent = none shared.
  notesSnapshot   Json?
  createdAt       DateTime       @default(now())
  acknowledgedAt  DateTime?

  @@index([toCounselorId])
  @@index([fromCounselorId])
}

enum AssignedResourceKind {
  LINK
  PDF
  TEXT
  ASSIGNMENT
  // The Cognitive Reframing exercise, embedded and played inline on the
  // client's My Profile page rather than opened as a link — see
  // MyToolsItem and the reframing-tool component. No url/fileData/content
  // needed; the client identifies it purely by this kind.
  REFRAMING_TOOL
}

// A resource a therapist has sent directly to one specific client — visible
// only to that client, surfaced in their own logged-in account under
// Resources > "My tools" (matched by clientEmail against their session
// email; see getMyAssignedResources). Distinct from ToolkitItem (a
// therapist's own private toolbox, never client-facing) and from
// CLIENT_TOOLS (public self-serve exercises anyone can open) — this is the
// first place a counselor's own content reaches a client's logged-in
// account UI.
model AssignedResource {
  id          String               @id @default(cuid())
  counselor   Counselor            @relation(fields: [counselorId], references: [id])
  counselorId String
  clientEmail String
  title       String
  description String?              @db.Text
  kind        AssignedResourceKind
  // Set for LINK — either a hand-typed URL or one of the built-in
  // CLIENT_TOOLS, quick-picked in the therapist portal.
  url         String?              @db.Text
  // Set for PDF (a data: URI, same storage pattern as ToolkitItem).
  fileData    String?              @db.Text
  fileName    String?
  // Set for TEXT/ASSIGNMENT — the free-text note or instructions.
  content     String?              @db.Text
  // Set when the client marks this tool done from their own account —
  // available for every kind (link, PDF, note, or assignment).
  completedAt DateTime?
  // Set the first time the client opens Resources > "My tools" after this
  // was sent — drives the unread-count badge on the Resources tab and the
  // installed-app icon (see client-resources.ts). Null = unread.
  viewedAt    DateTime?
  createdAt   DateTime             @default(now())

  @@index([counselorId])
  @@index([clientEmail])
}

enum SessionType {
  INDIVIDUAL_COUNSELING
  COUPLES_COUNSELING
  FOLLOW_UP
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Admin-created, broadcast to every logged-in client (no per-client
// sign-up step) — surfaced in the site header's notification bell
// alongside that client's own upcoming counseling sessions.
model Event {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  startAt     DateTime
  location    String?
  // Online session link, set at creation — shown only to clients who RSVP
  // "attending", both on /upcoming and via their read/unread notification.
  meetingLink String?
  createdAt   DateTime    @default(now())
  rsvps       EventRSVP[]
  // Optional Arabic translations, admin-entered per event, falling back to
  // the English fields whenever empty — shown to viewers whose site locale
  // is Arabic (bell/notification list) and used for the Arabic half of the
  // locale-split "new event" push notification.
  titleAr       String?
  descriptionAr String?  @db.Text

  @@index([startAt])
}

enum RSVPStatus {
  ATTENDING
  MAYBE
  NOT_ATTENDING
}

// One client's RSVP to a broadcast Event — surfaced to the admin on
// /admin/events (tallies + respondent list) and the Overview dashboard.
model EventRSVP {
  id        String     @id @default(cuid())
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    RSVPStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([eventId, userId])
}

// Marks one /upcoming row (a session, request, or event — keyed by the
// same "session-<id>"/"request-<id>"/"event-<id>" id used throughout
// upcoming-items.ts) as opened by this client, so the bell badge only
// counts what they haven't seen yet.
model NotificationRead {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  itemId    String
  readAt    DateTime @default(now())
  // Swiped away on /upcoming — permanently hidden for this client (the
  // underlying session/request/event itself is untouched; this only hides
  // the notification row).
  dismissed Boolean  @default(false)

  @@unique([userId, itemId])
}

model BookingRequest {
  id             String        @id @default(cuid())
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  counselor      Counselor     @relation(fields: [counselorId], references: [id])
  counselorId    String
  name           String
  email          String
  phone          String
  sessionType    SessionType   @default(INDIVIDUAL_COUNSELING)
  preferredDate  String
  preferredTime  String
  message        String?       @db.Text
  status         BookingStatus @default(PENDING)
  // Set by the counselor from their portal once a session is confirmed —
  // immediately surfaced to the client on /upcoming and emailed to them.
  meetingLink    String?
  // Set the first time the client taps this booking's meeting link from
  // /upcoming — lets it move to /upcoming/past right away instead of
  // waiting for preferredDate to roll into the past.
  joinedAt       DateTime?
  // Set once the day-before push reminder (see the session-reminders cron)
  // has gone out for this booking, so it's never sent twice.
  reminderSentAt DateTime?
  // Same purpose as SessionBooking.cancelledAt — set when status flips to
  // CANCELLED, read by the trash-purge cron to hard-delete a month later.
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
}

// A recurring weekly window (e.g. "Monday 09:00–17:00") a counselor has
// opened up for bookings. The public counselor page slices these into
// concrete 50-minute slots for the next couple of weeks (see
// availability.ts) so a client picks a real open time instead of
// submitting a free-text "preferred" date/time that has to be manually
// confirmed.
model CounselorAvailability {
  id          String    @id @default(cuid())
  counselor   Counselor @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  counselorId String
  // Exactly one of dayOfWeek/date is set (enforced in
  // therapist-availability-actions.ts, not at the DB level — same
  // application-level-validation convention as the rest of this app).
  // 0 = Sunday … 6 = Saturday, matching JS Date#getDay(). Set for a
  // recurring weekly window; null for a one-off single-date window.
  dayOfWeek   Int?
  // "YYYY-MM-DD". Set for a one-off window opened for a specific day
  // (today up to a month out); null for a recurring weekly window.
  date        String?
  // 24-hour "HH:mm", e.g. "09:00" / "17:00". No timezone — like the rest of
  // this app, times are plain Cairo-local values, never converted.
  startTime   String
  endTime     String

  @@index([counselorId])
}

enum InquiryStatus {
  NEW
  IN_DISCUSSION
  SCHEDULED
  CLOSED
}

model WorkshopInquiry {
  id               String        @id @default(cuid())
  organizationName String
  contactName      String
  email            String
  phone            String
  workshopTopic    String
  groupSize        String?
  preferredDates   String?
  message          String?       @db.Text
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())

  @@index([createdAt])
}

enum ProductCategory {
  JOURNAL
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String          @db.Text
  category    ProductCategory @default(JOURNAL)
  coverImageUrl String?
  durationDays  Int?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  // Optional Arabic translations — null/empty falls back to the English
  // field above, so the shop still renders in Arabic view before an admin
  // fills these in.
  titleAr       String?
  descriptionAr String?         @db.Text

  variants   ProductVariant[]
  orderItems OrderItem[]
  promoCodes PromoCodeProduct[]
}

// EBOOK is intentionally kept even though nothing creates or sells that
// format anymore (see the 20260917190000_remove_ebook_purchase_option
// migration) — Postgres can't drop an enum value without recreating the
// type, which fails if any row still references it, so it's left defined
// but unused rather than risk that against data this schema can't inspect.
enum ProductFormat {
  PHYSICAL
  EBOOK
}

model ProductVariant {
  id         String        @id @default(cuid())
  product    Product       @relation(fields: [productId], references: [id])
  productId  String
  format     ProductFormat
  priceEGP   Int
  sku        String        @unique
  // Physical-stock count. Null means untracked/unlimited. (Historically also
  // used for the now-removed EBOOK format, which had no inventory to run
  // out of.) When set, the shop shows "Only N left" under a low-stock
  // threshold and blocks purchase at 0.
  stockCount Int?

  orderItems OrderItem[]

  @@unique([productId, format])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  INSTAPAY
  CASH_ON_DELIVERY
  PAYMOB
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

// Admin-created discount codes for shop checkout. discountValue is either a
// percent (1-100) or a fixed EGP amount, per discountType. All limits are
// optional (null = no limit) so a code can be as simple or as constrained
// as a given campaign needs.
model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  discountType    PromoDiscountType
  discountValue   Int
  active          Boolean           @default(true)
  expiresAt       DateTime?
  maxRedemptions  Int?
  redemptionCount Int               @default(0)
  minOrderEGP     Int?
  createdAt       DateTime          @default(now())

  orders          Order[]
  sessionBookings SessionBooking[]
  // Empty = applies to every product. Non-empty = the discount only
  // counts toward these products' share of the cart.
  products   PromoCodeProduct[]
  // Empty = applies to every therapist's session price. Non-empty = only
  // valid when booking one of these counselors.
  counselors PromoCodeCounselor[]
  // Present only for a code auto-generated by the referral system (see
  // Referral below) — distinguishes a friend's welcome discount from an
  // ordinary admin-authored code.
  userReferral   UserReferral?
}

// One row per successfully activated invite-a-friend referral — created
// only once the invited friend's PWA install actually completes (see
// activateReferral() in referral-actions.ts), never for a click or a
// signup alone. Existence of the row IS the "activated" state, so there's
// no separate status field. promoCodeId is unique/1:1: each activation
// mints exactly one single-use 20%-off code for the friend. Named
// "UserReferral" (not "Referral") to avoid colliding with the unrelated
// therapist-to-therapist Referral model above.
model UserReferral {
  id          String    @id @default(cuid())
  referrer    User      @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId  String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  promoCodeId String    @unique
  activatedAt DateTime  @default(now())

  @@index([referrerId])
}

model PromoCodeProduct {
  id          String    @id @default(cuid())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  promoCodeId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String

  @@unique([promoCodeId, productId])
}

model PromoCodeCounselor {
  id          String    @id @default(cuid())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  promoCodeId String
  counselor   Counselor @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  counselorId String

  @@unique([promoCodeId, counselorId])
}

model Order {
  id              String        @id @default(cuid())
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  guestName       String
  guestEmail      String
  guestPhone      String
  shippingAddress String?       @db.Text
  googleMapsLink  String?
  country         String?
  governorate     String?
  needsShipping   Boolean       @default(false)
  subtotalEGP     Int
  shippingFeeEGP  Int           @default(0)
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id])
  promoCodeId     String?
  discountEGP     Int           @default(0)
  totalEGP        Int
  paymentMethod   PaymentMethod @default(INSTAPAY)
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentRef      String?
  paymentNote     String?       @db.Text
  // Site language active when this order was placed — the Paymob webhook
  // that confirms payment runs server-to-server with no visitor cookie, so
  // it needs this to send the confirmation email in the right language.
  locale          String        @default("en")
  // Hashed bearer token required to view/act on this order's confirmation
  // page as a guest — see the matching field on SessionBooking above for
  // the full reasoning. Logged-in customers bypass this via userId instead.
  accessTokenHash String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]
}

model OrderItem {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          String
  product          Product        @relation(fields: [productId], references: [id])
  productId        String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  quantity         Int
  unitPriceEGP     Int
  titleSnapshot    String
  formatSnapshot   ProductFormat
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WorkshopInterestSignup {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ResourceNotifySignup {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model JournalPrompt {
  id        String   @id @default(cuid())
  dayNumber Int      @unique
  category  String
  text      String   @db.Text
  // Optional Arabic translations, falling back to the English fields when
  // empty — same pattern as Article/Product/Counselor above.
  textAr     String? @db.Text
  categoryAr String?

  entries JournalEntry[]
}

model JournalEntry {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id])
  userId     String
  prompt     JournalPrompt? @relation(fields: [promptId], references: [id])
  promptId   String?
  content    String         @db.Text
  mood       String?
  bookmarked Boolean        @default(false)
  // A single client-compressed photo, stored as a data URI — there's no
  // blob storage wired up yet, and this keeps the feature self-contained.
  photoUrl   String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  // The site locale ("en"/"ar") active when this browser subscribed, kept
  // in sync on every language switch (see setLocale) — lets a broadcast
  // push pick the right language per recipient at send time, since a push
  // payload is fixed the moment it's sent, unlike a page render.
  locale    String   @default("en")
}

// One row per page a logged-in person opens — the only usage signal behind
// the admin analytics page's "most/least used features" and "time spent"
// numbers (see src/lib/analytics.ts). Deliberately just a path + timestamp:
// no query params, no referrer, nothing about what's actually on the page
// (journal entry content in particular never touches the server at all —
// see JournalEntry/local-journal.ts). Anonymous/logged-out browsing is
// never recorded.
model PageView {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  path      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// The general-purpose behavioral event log — every tracked "someone did
// something" moment, shaped as (object, action) pairs (e.g. object
// "SessionBooking", action "created") rather than one bespoke table per
// feature. Backs the AARRR/HEART/stickiness/adoption/time-to-value
// reporting on /admin/behavioral-analytics; PageView (route views only)
// and AuditLog (admin/system actions only) stay as they are and are read
// alongside this table, not replaced by it.
//
// userId is nullable because some of the events worth counting for
// Acquisition/Revenue happen before or without an account at all (guest
// shop checkout, guest session booking) — those rows carry object/action
// and non-PII properties only. Anything that needs a specific user (TTV,
// feature-adoption depth, retention) naturally only considers rows where
// userId is set.
model AnalyticsEvent {
  id     String @id @default(cuid())
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?
  // PascalCase-ish entity name the action happened to, e.g. "User",
  // "JournalEntry", "SessionBooking", "Order", "Assessment", "Feedback",
  // "Referral". Deliberately a plain string, not an enum — new event
  // types shouldn't need a migration to start being recorded.
  object String
  // snake_case verb, e.g. "signed_up", "logged_in", "created", "started",
  // "completed", "confirmed", "submitted", "activated".
  action String
  // Small, non-PII context (e.g. { referralSource }, { assessmentType },
  // { amountEGP }) — never raw journal/assessment content or contact info.
  properties Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([object, action, createdAt])
}

// A registered platform authenticator (Face ID, Touch ID, Windows Hello,
// Android fingerprint) letting the journal lock be opened with a biometric
// instead of re-entering the account password — see src/lib/webauthn.ts.
// One row per enrolled device/browser; a user can have several.
model WebAuthnCredential {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Base64url-encoded credential id reported by the authenticator —
  // globally unique, used to look up which row to verify an assertion
  // against.
  credentialId String @unique
  publicKey    Bytes
  // Anti-replay counter the authenticator increments on each use; verified
  // to have strictly increased on every unlock attempt.
  counter      BigInt @default(0)
  transports   String[] @default([])
  createdAt    DateTime @default(now())
}

enum LeadType {
  WORKSHOP_LEAD
  COUNSELING_INQUIRY
  JOURNAL_CUSTOMER
  GENERAL_INQUIRY
  ACCOUNT_SIGNUP
  RESOURCE_NOTIFY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/** Unified CRM record — one row per real workshop lead, counseling inquiry,
 * journal order, or general inquiry, created alongside each source record
 * so the whole pipeline can be tracked and worked from one place. */
model Lead {
  id            String     @id @default(cuid())
  name          String
  type          LeadType
  status        LeadStatus @default(NEW)
  email         String?
  phone         String?
  source        String?
  sessionType   String?
  groupSize     Int?
  orderTotalEGP Int?
  paymentMethod String?
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([type, createdAt])
  @@index([createdAt])
}

// One row per public-form submission attempt, used only to enforce the
// 3-requests-per-10-minutes-per-IP limit shared across every unauthenticated
// lead-capturing form (contact, workshop interest/inquiry, resource notify,
// booking request) — see checkRateLimit() in anti-spam.ts. `key` is
// "<routeKey>:<ip>" so each form has its own quota per IP. Rows past their
// window are opportunistically deleted the next time that same key is hit,
// which keeps this table's size roughly proportional to actual traffic
// instead of growing without bound the way Lead/ContactMessage did during
// the September 2026 spam-bot incident.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Sitewide feature toggles editable from /admin/settings, without a code
// change or redeploy. Single row, always looked up by the fixed id
// "singleton" — see src/lib/site-settings.ts.
model SiteSettings {
  id                      String                  @id @default("singleton")
  arabicEnabled           Boolean                 @default(true)
  // Article slugs hidden from the Resources listing. Still reachable at
  // their direct URL — this is an archive toggle, not a delete. Edited from
  // /admin/resources alongside the ResourceBlock ordering below, even
  // though it lives on this row rather than its own.
  hiddenArticleSlugs      String[]                @default([])
  // Hides the "Let it out. One page at a time." teal card / journal-app
  // button on the homepage.
  hideJournalTaglineButton Boolean                @default(false)
  // A single agreement PDF the admin uploads and every therapist can
  // download from their portal's Legal page — same base64 data-URI
  // storage as ToolkitItem/AssignedResource, no per-therapist variants.
  therapistAgreementFileData String?               @db.Text
  therapistAgreementFileName String?
  updatedAt               DateTime                @updatedAt
}

enum ResourceBlockKind {
  JOURNAL_PROMO
  CBT_PROMO
  BREATHING_PROMO
  ASSESSMENTS_PROMO
  ARTICLES
}

// One row per section on the /resources page (the journal/CBT/breathing/
// assessments promo cards, plus the article list itself) — lets an admin
// hide or reorder any of them from /admin/resources. `kind` is the row's
// own primary key since this is a small fixed set, never admin-created or
// deleted. Each promo kind's editable title/label/body/CTA text lives in
// SiteText (see site-text.ts), not here — this table is purely about
// visibility and order; ARTICLES ignores SiteText entirely since the
// article list has no single editable title/body of its own.
model ResourceBlock {
  kind      ResourceBlockKind @id
  hidden    Boolean           @default(false)
  sortOrder Int               @default(0)
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  category    String
  readMinutes Int      @default(5)
  // ArticleSection[] / ArticleCheckIn[] (see src/lib/content/articles.ts) —
  // stored as JSON since each article's section/check-in shape is
  // free-form, admin-authored content, not a fixed relational shape.
  sections    Json
  checkIns    Json
  references  String[] @default([])
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Optional Arabic translations — same shape as their English
  // counterparts above. Null/empty falls back to English, so an article
  // still renders in Arabic view before an admin fills these in.
  titleAr     String?
  excerptAr   String?  @db.Text
  sectionsAr  Json?
  checkInsAr  Json?
  categoryAr  String?
}

// Singleton row holding the counseling intake form's questions (see
// src/lib/intake-form-schema.ts for the IntakeSection[] shape) — editable
// from /admin/intake-form instead of being hardcoded, since it's clinical
// content the practice owner needs to be able to adjust without a deploy.
model IntakeFormConfig {
  id         String   @id @default("singleton")
  sections   Json
  // Optional Arabic translation of `sections`, same IntakeSection[] shape —
  // admin-editable from /admin/intake-form. Null/missing means no Arabic
  // version has been entered yet, so Arabic-locale clients still see the
  // English questions (never a blank form).
  sectionsAr Json?
  updatedAt  DateTime @updatedAt
}

// Singleton row holding the "in-between sessions" reflection sheet's
// questions (a flat, ordered list — see src/lib/reflection-sheet-config.ts
// for the ReflectionQuestion[] shape). Admin-editable from
// /admin/reflection-sheet. Seeded with a starter set of prompts via
// migration (see 20260827190000_add_reflection_sheet), since this needs to
// exist in production without an admin visiting the dashboard first.
model ReflectionSheetConfig {
  id          String   @id @default("singleton")
  questions   Json
  // Optional, fully independent Arabic version of `questions` (own
  // question count/order — nothing requires it to mirror the English
  // list, since answers are stored purely on the client's own device and
  // never parsed against this config server-side). Null/empty falls back
  // to English.
  questionsAr Json?
  updatedAt   DateTime @updatedAt
}

// One row per counseling session that has already prompted its client to
// fill out the private "in-between sessions" reflection sheet — created by
// the reflection-prompts cron once a session's day has passed. Doubles as
// both the "already notified" guard (via the unique constraint below) and
// the in-app notification record surfaced on /upcoming, read-tracked the
// same way as sessions/events (see NotificationRead, itemId
// "reflection-<id>"). The reflection sheet's actual answers are never
// stored here or anywhere server-side — see src/lib/local-reflection.ts.
model ReflectionPrompt {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // Which booking triggered this — "session" (SessionBooking) or
  // "request" (BookingRequest) — kept for debugging/traceability only.
  sourceKind String
  sourceId   String
  createdAt  DateTime @default(now())

  @@unique([sourceKind, sourceId])
}

// Admin-editable overrides for specific English UI strings, keyed by
// dictionary path (e.g. "home.heroCtaBook", "nav.counseling"). A missing
// key means "use the default from dictionaries/en.ts". Only ever applied
// when the visitor's locale is English — Arabic strings are untouched.
model SiteText {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

enum SupportChatStatus {
  // Conversation still in progress, or ended without either side marking
  // an outcome.
  OPEN
  // The bot (or the admin, manually) determined the issue was fixed.
  RESOLVED
  // The bot couldn't resolve it — the admin gets a one-time email
  // notification (see escalatedAt) and reviews the transcript in
  // /admin/support.
  ESCALATED
}

// A client's "Having technical issues? Live Chat" conversation from
// Account settings, answered by an AI assistant scoped to app/technical
// problems only — never psychological ones (enforced in the system
// prompt in ai-support-chat.ts, and disclaimed in the chat UI itself).
model SupportChat {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  // [{ role: "user" | "assistant", content: string, at: ISO string }] —
  // the full transcript, simplest storage for something only ever read
  // back as a whole (the chat UI, or the admin transcript view).
  messages Json

  status SupportChatStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Set the first time this chat is escalated — guards against re-sending
  // the admin notification email on every subsequent unresolved turn.
  escalatedAt DateTime?
  resolvedAt  DateTime?

  // Post-resolution feedback loop: once the bot marks a chat RESOLVED, the
  // client is asked to confirm it actually fixed things and (optionally)
  // rate the chat. Null on both until the client answers.
  feedbackResolved Boolean?
  feedbackRating   Int?
  // Set when the client says the bot's "resolved" claim was wrong —
  // surfaced prominently in the admin dashboard so a human follows up.
  // Cleared automatically when an admin marks the chat resolved again.
  flaggedUnresolved Boolean @default(false)

  @@index([userId])
  @@index([status])
}

enum AuditSeverity {
  INFO
  WARNING
  SECURITY
}

// A permanent record of admin mutations, admin login activity, and
// notable background-job outcomes — the source for both the Audit Logs
// page (the full, filterable history) and the Notification Center (a
// curated feed of the same rows). actorId deliberately uses SetNull, not
// the CASCADE every other user-owned table uses: this is the one place an
// account's own deletion (or someone else's account being deleted by an
// admin) should NOT take the historical record with it — actorEmail is
// snapshotted at write time so a row still reads sensibly once actorId
// has gone null.
model AuditLog {
  id         String        @id @default(cuid())
  actor      User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorEmail String?
  // Dot-namespaced event key, e.g. "order.status_changed",
  // "admin.login_failed", "cron.journal_reminder" — grouped/filtered by
  // this in both the Audit Logs and Notification Center pages.
  action     String
  targetType String?
  targetId   String?
  // Short human-readable line generated once at write time (e.g. "Marked
  // order #A1B2C3D4 as Shipped") so every page that lists these rows can
  // render directly without re-deriving text from action/metadata per row
  // type.
  summary    String
  // Small structured detail alongside summary — e.g. {from: "PENDING",
  // to: "SHIPPED"} for a status change. Never the full before/after of a
  // large record, and never raw request bodies (this can hold arbitrary
  // admin-entered text, so it's for display only, never re-interpreted as
  // code or HTML).
  metadata   Json?
  severity   AuditSeverity @default(INFO)
  ip         String?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// A 24-hour undo buffer for admin deletes — see src/lib/trash.ts. Every
// admin delete this app supports (see RESTORE_HANDLERS there) writes one
// row here *before* the real delete, holding a full JSON snapshot of the
// row (and, for models with real children like Order/OrderItem, those
// children too) — not a soft-delete flag on the original table, so no
// query anywhere else in the app needs to remember to filter these out.
// A cron (api/cron/trash-purge, see vercel.json) hard-deletes rows once
// `deletedAt` is more than 24h old; restoring recreates the original
// row(s) with their original id via RESTORE_HANDLERS and removes this
// row. deletedById deliberately uses SetNull, same reasoning as
// AuditLog.actorId — deletedByEmail is snapshotted so the row still reads
// sensibly once the admin's own account is gone.
model TrashedItem {
  id             String   @id @default(cuid())
  // The original Prisma model name (e.g. "Order", "Product") — looked up
  // against RESTORE_HANDLERS to know how to recreate the row(s).
  modelName      String
  // The original row's id, kept even after data is JSON — used to restore
  // with the same id (so anything that referenced it, e.g. a
  // NotificationRead itemId, still resolves) and shown in the UI.
  originalId     String
  // Short human-readable line for the Recently Deleted list (e.g. "Order
  // #A1B2C3D4 · 450 EGP"), generated once at write time — same convention
  // as AuditLog.summary.
  summary        String
  // The full row (Date fields as ISO strings) — and, for models with
  // real children, `{ ...row, _children: [...] }` — enough for the
  // matching RESTORE_HANDLERS entry to recreate it exactly.
  data           Json
  deletedBy      User?    @relation(fields: [deletedById], references: [id], onDelete: SetNull)
  deletedById    String?
  deletedByEmail String?
  deletedAt      DateTime @default(now())

  @@index([deletedAt])
  @@index([modelName, originalId])
}

// One row per email address that has ever visited the "manage email
// preferences" page (linked from the footer of every customer-facing
// email, see emailShell in src/lib/email.ts) and changed something — a
// missing row means "no preference set", i.e. receive everything. Keyed
// by the raw lowercased email, not User.id, so it works the same way for
// a guest who only ever submitted a contact form as for a full account
// holder. notificationsOptOut only gates the one genuinely optional email
// this app sends (a counselor assigning a resource) — every other email
// (OTP, password reset, order/booking confirmations, meeting links,
// intake requests) is essential to something the recipient asked for and
// always sends regardless of this flag; the preferences page says so.
model EmailPreference {
  email               String   @id
  notificationsOptOut Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

// Which part of the app a Feedback row is about — the picker on the
// /feedback page, and the filter on the admin feedback list.
enum FeedbackService {
  COUNSELING
  JOURNALS
  WORKSHOPS
  RESOURCES
  SHOP
  APP_GENERAL
}

// A star rating + optional comment about one service, submitted from
// /feedback. Logged-in users only (see requireUser() in
// feedback-actions.ts), so there's always a real account behind every
// row — no honeypot/rate-limit needed here the way the public
// lead-capturing forms need them.
model Feedback {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  service   FeedbackService
  rating    Int
  comment   String?         @db.Text
  createdAt DateTime        @default(now())

  @@index([createdAt])
}
