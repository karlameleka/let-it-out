generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  journalEntries JournalEntry[]
  bookingRequests BookingRequest[]
  orders         Order[]
}

model Counselor {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  credentials  String
  bio          String   @db.Text
  specialties  String[]
  photoUrl     String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  bookingRequests BookingRequest[]
}

enum SessionType {
  INDIVIDUAL_COUNSELING
  COUPLES_COUNSELING
  FOLLOW_UP
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model BookingRequest {
  id             String        @id @default(cuid())
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  counselor      Counselor     @relation(fields: [counselorId], references: [id])
  counselorId    String
  name           String
  email          String
  phone          String
  sessionType    SessionType   @default(INDIVIDUAL_COUNSELING)
  preferredDate  String
  preferredTime  String
  message        String?       @db.Text
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}

enum InquiryStatus {
  NEW
  IN_DISCUSSION
  SCHEDULED
  CLOSED
}

model WorkshopInquiry {
  id               String        @id @default(cuid())
  organizationName String
  contactName      String
  email            String
  phone            String
  workshopTopic    String
  groupSize        String?
  preferredDates   String?
  message          String?       @db.Text
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
}

enum ProductCategory {
  JOURNAL
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String          @db.Text
  category    ProductCategory @default(JOURNAL)
  coverImageUrl String?
  durationDays  Int?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)

  variants   ProductVariant[]
  orderItems OrderItem[]
}

enum ProductFormat {
  PHYSICAL
  EBOOK
}

model ProductVariant {
  id         String        @id @default(cuid())
  product    Product       @relation(fields: [productId], references: [id])
  productId  String
  format     ProductFormat
  priceEGP   Int
  sku        String        @unique

  orderItems OrderItem[]

  @@unique([productId, format])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  INSTAPAY
  CASH_ON_DELIVERY
}

model Order {
  id              String        @id @default(cuid())
  user            User?         @relation(fields: [userId], references: [id])
  userId          String?
  guestName       String
  guestEmail      String
  guestPhone      String
  shippingAddress String?       @db.Text
  needsShipping   Boolean       @default(false)
  subtotalEGP     Int
  totalEGP        Int
  paymentMethod   PaymentMethod @default(INSTAPAY)
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentRef      String?
  paymentNote     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]
}

model OrderItem {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          String
  product          Product        @relation(fields: [productId], references: [id])
  productId        String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  quantity         Int
  unitPriceEGP     Int
  titleSnapshot    String
  formatSnapshot   ProductFormat
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model WorkshopInterestSignup {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())
}

model JournalPrompt {
  id        String   @id @default(cuid())
  dayNumber Int      @unique
  category  String
  text      String   @db.Text

  entries JournalEntry[]
}

model JournalEntry {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id])
  userId    String
  prompt    JournalPrompt? @relation(fields: [promptId], references: [id])
  promptId  String?
  content   String         @db.Text
  mood      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}
